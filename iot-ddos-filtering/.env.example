# ======================================================
# .env.example — copy to .env and adjust as needed
# ======================================================

# Flask
FLASK_HOST=0.0.0.0
FLASK_PORT=5000
FLASK_DEBUG=false
SECRET_KEY=change-me-in-production

# SQLite database location (relative to project root)
DATABASE_PATH=data/iot_ddos.db

# MQTT (Mosquitto)
MQTT_BROKER_HOST=localhost
MQTT_BROKER_PORT=1883
MQTT_TOPIC=iot/+/telemetry
MQTT_CLIENT_ID=iot-ddos-backend
MQTT_KEEPALIVE=60

# Ryu SDN controller REST API
RYU_HOST=localhost
RYU_PORT=8080

# Open vSwitch switch name (as seen in `ovs-vsctl show`)
OVS_SWITCH_NAME=s1

# ML model artifacts
MODEL_PATH=ml/artifacts/rf_model.joblib
SCALER_PATH=ml/artifacts/scaler.joblib
ENCODER_PATH=ml/artifacts/encoder.joblib
METRICS_PATH=ml/artifacts/metrics.json
MODEL_VERSION=rf-v1

# Detection & mitigation tuning
DETECTION_THRESHOLD=0.70
MIN_PACKET_RATE_THRESHOLD=100.0
MITIGATION_ENABLED=true

# Zeek log location (on the Ubuntu host)
ZEEK_LOG_PATH=/opt/zeek/logs/current/conn.log

# Dataset
DATASET_PATH=data/processed/dataset.csv
RANDOM_SEED=42
DATASET_SIZE=5000

# Set to "true" to run without Mininet/Ryu/Zeek
DEMO_MODE=true

# Logging: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# Monitoring poll interval (seconds)
MONITOR_INTERVAL_SECONDS=5.0
