# ============================================================
# .gitignore — Project root
# ============================================================

# ── Environment / secrets ─────────────────────────────────────
.env
.env.local
.env.*.local

# ── Python ────────────────────────────────────────────────────
__pycache__/
*.pyc
*.pyo
*.pyd
venv/
.venv/
*.egg-info/
dist/
build/
.pytest_cache/
.coverage
htmlcov/

# ── Docker ────────────────────────────────────────────────────
# Don't ignore docker-compose.yml or Dockerfiles — they're tracked

# ── OS / editor ───────────────────────────────────────────────
.DS_Store
Thumbs.db
*.swp
*.swo
*~
.vscode/
.idea/

# ── Logs ──────────────────────────────────────────────────────
*.log

