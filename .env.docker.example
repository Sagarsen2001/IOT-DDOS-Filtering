# ======================================================
# .env.docker.example
# ======================================================
# Copy to .env in the same directory as docker-compose.yml
# and adjust as needed.
#
#   cp .env.docker.example .env
#
# Docker Compose automatically reads .env from the same
# directory as the compose file.
# ======================================================

# ── Host port mappings ────────────────────────────────
# Change these if the default ports conflict with other services
FRONTEND_HOST_PORT=8080
BACKEND_HOST_PORT=5000
MQTT_HOST_PORT=1883

# ── Demo Mode ─────────────────────────────────────────
# true  = synthetic traffic, simulated OVS/Ryu/Zeek
# false = expects real Zeek logs, OVS, and Ryu on the host
DEMO_MODE=true

# ── Flask ─────────────────────────────────────────────
FLASK_DEBUG=false
SECRET_KEY=change-me-in-production

# ── Detection / Mitigation ───────────────────────────
DETECTION_THRESHOLD=0.7
MITIGATION_ENABLED=false

# ── Logging ───────────────────────────────────────────
LOG_LEVEL=INFO

# ── Monitoring ────────────────────────────────────────
MONITOR_INTERVAL_SECONDS=5.0

